{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["build/", ".svelte-kit/", "node_modules/"],
  "rules": {
    "unicorn/require-module-specifiers": "off"
  }
}
