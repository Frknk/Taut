# Copia a .env si la API no corre en el puerto por defecto. Se lee al construir (PUBLIC_*).
PUBLIC_API_URL=http://localhost:8080
# Status BFF, que sirve el JSON de las páginas de estado públicas.
PUBLIC_STATUS_URL=http://localhost:8085
# Auth service (registro, login, sesiones). El panel le envía la cookie de sesión.
PUBLIC_AUTH_URL=http://localhost:8086
# Cloudflare Turnstile en registro, login y recuperación (es pública). Vacía = sin widget, y
# taut-auth debe tener el captcha apagado. Clave de prueba que siempre pasa: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITEKEY=
