    {
      "type": "timeseries",
      "title": "Cola de JetStream por consumer",
      "description": "Pendientes: mensajes que el consumer aún no recibió. Sin ack: entregados y en proceso. Si los pendientes crecen, el consumer no da abasto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
