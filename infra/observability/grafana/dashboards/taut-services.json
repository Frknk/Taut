        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (stream_name, consumer_name) (jetstream_consumer_num_pending)",
          "legendFormat": "{{stream_name}} / {{consumer_name}} pendientes",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (stream_name, consumer_name) (jetstream_consumer_num_ack_pending)",
          "legendFormat": "{{stream_name}} / {{consumer_name}} sin ack",
          "refId": "B"
        }
      ],
      "id": 11
    },
