{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.id, m.name,\n               CASE WHEN NOT m.active THEN 'paused' ELSE coalesce(s.status, 'pending') END\n                   AS \"status!: MonitorStatus\"\n        FROM monitors m\n        LEFT JOIN monitor_status s ON s.monitor_id = m.id\n        WHERE m.tenant_id = $1\n        ORDER BY m.created_at\n        ",
