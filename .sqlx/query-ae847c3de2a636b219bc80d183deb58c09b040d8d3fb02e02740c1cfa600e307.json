  "query": "\n        SELECT u.id AS user_id, u.name, u.email, m.role AS \"role: Role\", m.created_at AS joined_at\n        FROM memberships m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.tenant_id = $1\n        ORDER BY m.created_at, u.email\n        ",
