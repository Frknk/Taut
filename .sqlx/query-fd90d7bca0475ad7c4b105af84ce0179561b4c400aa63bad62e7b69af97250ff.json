  "query": "\n        SELECT t.id, t.slug, t.name, t.plan AS \"plan: Plan\", t.created_at, m.role AS \"role: Role\"\n        FROM memberships m\n        JOIN tenants t ON t.id = m.tenant_id\n        WHERE m.user_id = $1\n        ORDER BY lower(t.name), t.created_at\n        ",
