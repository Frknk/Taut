{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, tenant_id, last_ping_at AS \"last_ping_at!\", interval_s, grace_period_s\n        FROM monitors\n        WHERE id = ANY($1)\n          AND active\n          AND kind = 'heartbeat'\n          AND last_ping_at IS NOT NULL\n          AND last_ping_at < now() - make_interval(secs => interval_s + grace_period_s)\n        ",
