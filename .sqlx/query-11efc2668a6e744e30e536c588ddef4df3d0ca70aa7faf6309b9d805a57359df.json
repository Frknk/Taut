  "db_name": "PostgreSQL",
  "query": "\n        SELECT i.id, i.email, i.role AS \"role: Role\", u.name AS \"invited_by?\", i.expires_at,\n               i.created_at\n        FROM invitations i\n        LEFT JOIN users u ON u.id = i.invited_by\n        WHERE i.tenant_id = $1 AND i.accepted_at IS NULL\n        ORDER BY i.created_at DESC\n        ",
