  "db_name": "PostgreSQL",
  "query": "\n        SELECT k.id AS key_id, k.scope, k.last_used_at,\n               t.id, t.slug, t.name, t.plan AS \"plan: Plan\", t.created_at\n        FROM api_keys k\n        JOIN tenants t ON t.id = k.tenant_id\n        WHERE k.key_hash = $1 AND k.revoked_at IS NULL\n        ",
