# Copia este archivo a .env (`just setup` lo hace). .env nunca se versiona.
# Las variables TAUT_* mapean a taut_config::Settings usando `__` como separador.

# Conexiones. Van sin prefijo porque sqlx-cli y las imágenes oficiales usan estos nombres.
DATABASE_URL=postgres://taut:taut@localhost:5432/taut
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Servicio
TAUT_APP__ENV=dev
TAUT_HTTP__ADDR=0.0.0.0:8080
# Orígenes del panel, separados por coma. Tiene que ser una lista explícita (no `*`): el panel
# envía la cookie de sesión y los navegadores no mandan credenciales a un origen comodín.
TAUT_HTTP__CORS_ORIGINS=http://localhost:5173
# Detrás del ingress, `true` para leer la IP del cliente de X-Forwarded-For (límites de login).
TAUT_HTTP__TRUST_PROXY=false
TAUT_DATABASE__MIGRATE_ON_START=true
# URL del panel, para los enlaces de alertas y de correos de cuenta.
TAUT_APP__PANEL_URL=http://localhost:5173

# Auth: dónde está el servicio (la api descarga su JWKS) y la clave Ed25519 que firma los
# tokens. Vacía en dev = clave efímera por proceso (los tokens mueren con él; las sesiones no,
# viven en Redis). Para una fija: openssl genpkey -algorithm ed25519 -out .auth-key.pem
# (ignorado por git) y TAUT_AUTH__SIGNING_KEY_FILE=.auth-key.pem. Fuera de dev es obligatoria.
TAUT_AUTH__URL=http://localhost:8086
TAUT_AUTH__SIGNING_KEY_FILE=

# Monitores contra localhost o redes privadas: prohibidos por defecto (y en producción);
# en local se permiten para vigilar servicios de la propia máquina.
TAUT_CHECKS__ALLOW_PRIVATE_TARGETS=true
# Etiqueta de región del checker y chequeos simultáneos por proceso.
TAUT_CHECKS__REGION=local
TAUT_CHECKS__CONCURRENCY=100

# Correo: SMTP de Mailpit en local (bandeja en http://localhost:8025). En producción
# TAUT_NOTIFIER__SMTP_URL lleva credenciales: va en un Secret, nunca aquí.
TAUT_NOTIFIER__SMTP_URL=smtp://localhost:1025
TAUT_NOTIFIER__EMAIL_FROM="taut <alertas@taut.localhost>"

# Logs: pretty en local, json en contenedores. RUST_LOG filtra por crate.
TAUT_TELEMETRY__LOG_FORMAT=pretty
RUST_LOG=info,taut_api=debug,taut_auth=debug,taut_identity=debug,taut_http=debug,taut_db=debug,taut_bus=debug,taut_scheduler=debug,taut_checker=debug,taut_incidents=debug,taut_notifier=debug,sqlx=warn
