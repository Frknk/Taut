{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "-p",
        "taut-api"
      ],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd=web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "scheduler",
      "runtimeExecutable": "just",
      "runtimeArgs": [
        "run",
        "scheduler"
      ],
      "port": 8081
    },
    {
      "name": "checker",
      "runtimeExecutable": "just",
      "runtimeArgs": [
        "run",
        "checker"
      ],
      "port": 8082
    },
    {
      "name": "incidents",
      "runtimeExecutable": "just",
      "runtimeArgs": [
        "run",
        "incidents"
      ],
      "port": 8083
    }
  ]
}
